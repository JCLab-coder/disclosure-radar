#!/bin/sh
# 이 저장소의 pre-commit 훅. 켜는 법: git config core.hooksPath .githooks
# core.hooksPath 를 이 폴더로 바꾸면 전역 훅이 돌지 않으므로, 전역 pre-commit 이 있으면 먼저 부른다.

global=$(git config --global --get core.hooksPath)
case "$global" in "~/"*) global="$HOME/${global#~/}" ;; esac
if [ -n "$global" ] && [ -x "$global/pre-commit" ]; then
  here=$(cd "$(dirname "$0")" && pwd -P)
  there=$(cd "$global" && pwd -P)
  if [ "$here" != "$there" ]; then
    "$global/pre-commit" "$@" || exit 1
  fi
fi

# 점검 스크립트는 작업 트리가 아니라 마지막 커밋(HEAD)에 있는 것을 돌린다.
# 그래서 커밋 안에서 점검 스크립트를 고쳐도, 그 커밋은 고치기 전 스크립트로 점검된다.
# HEAD 에 없으면(첫 커밋, 새로 더한 스크립트) 스테이지된 것을 돌리고 그렇다고 알린다.
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
run() {
  name=$1; shift
  if git cat-file -e "HEAD:scripts/$name" 2>/dev/null; then
    git show "HEAD:scripts/$name" > "$tmp/$name" || return 1
  elif git cat-file -e ":scripts/$name" 2>/dev/null; then
    echo "scripts/$name 이 마지막 커밋에 없어 스테이지된 것을 돌립니다." >&2
    git show ":scripts/$name" > "$tmp/$name" || return 1
  else
    echo "scripts/$name 이 없어 커밋하지 않는다." >&2
    return 1
  fi
  node "$tmp/$name" "$@"
}

run check-guard.mjs || exit 1
run check-secrets.mjs || exit 1
run check-wiki.mjs
