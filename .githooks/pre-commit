#!/bin/sh
# 이 저장소의 pre-commit 훅. 켜는 법: git config core.hooksPath .githooks
# core.hooksPath 를 이 폴더로 바꾸면 전역 훅이 돌지 않으므로, 전역 pre-commit 이 있으면 먼저 부른다.

global=$(git config --global --get core.hooksPath)
case "$global" in "~/"*) global="$HOME/${global#~/}" ;; esac
if [ -n "$global" ] && [ -x "$global/pre-commit" ]; then
  here=$(cd "$(dirname "$0")" && pwd -P)
  there=$(cd "$global" && pwd -P)
  if [ "$here" != "$there" ]; then
    "$global/pre-commit" "$@" || exit 1
  fi
fi

node "$(git rev-parse --show-toplevel)/scripts/check-wiki.mjs"
